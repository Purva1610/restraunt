<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - Fine Dining Restaurant</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo"><i class="fas fa-utensils"></i> Fine Dining</div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/menu" class="active">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Page Title -->
    <section class="page-title">
        <h1>Our Menu</h1>
        <p>Discover our exquisite culinary creations</p>
    </section>

    <!-- Menu Content -->
    <section class="menu-section">
        <div class="container">
            <div class="menu-categories">
                <!-- Appetizers -->
                <div class="category">
                    <h2><i class="fas fa-champagne-glasses"></i> Appetizers</h2>
                    <div class="menu-items">
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Foie Gras Terrine</h3>
                                <span class="price">$18</span>
                            </div>
                            <p>Smooth and buttery with truffle reduction</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Oysters Selection</h3>
                                <span class="price">$16</span>
                            </div>
                            <p>Fresh oysters served with champagne mignonette</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Seared Scallops</h3>
                                <span class="price">$15</span>
                            </div>
                            <p>Pan-seared with lemon beurre blanc</p>
                        </div>
                    </div>
                </div>

                <!-- Main Courses -->
                <div class="category">
                    <h2><i class="fas fa-utensils"></i> Main Courses</h2>
                    <div class="menu-items">
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Filet Mignon</h3>
                                <span class="price">$48</span>
                            </div>
                            <p>USDA Prime cut with red wine reduction and truffle mac & cheese</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Lobster Thermidor</h3>
                                <span class="price">$52</span>
                            </div>
                            <p>Maine lobster with creamy sauce and gratin topping</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Pan-Roasted Duck Breast</h3>
                                <span class="price">$42</span>
                            </div>
                            <p>Crispy skin with cherry gastrique and seasonal vegetables</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Wild Mushroom Risotto</h3>
                                <span class="price">$32</span>
                            </div>
                            <p>Creamy Arborio rice with truffle oil and parmesan</p>
                        </div>
                    </div>
                </div>

                <!-- Desserts -->
                <div class="category">
                    <h2>🍰 Desserts</h2>
                    <div class="menu-items">
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Chocolate Soufflé</h3>
                                <span class="price">$14</span>
                            </div>
                            <p>Light and airy with warm chocolate center</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Crème Brûlée</h3>
                                <span class="price">$12</span>
                            </div>
                            <p>Classic vanilla bean with caramelized sugar crust</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Seasonal Fruit Tart</h3>
                                <span class="price">$13</span>
                            </div>
                            <p>Buttery pastry with pastry cream and fresh fruits</p>
                        </div>
                    </div>
                </div>

                <!-- Wine Selection -->
                <div class="category">
                    <h2>🍷 Wine Selection</h2>
                    <div class="menu-items">
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Château Margaux 2015</h3>
                                <span class="price">$180/bottle</span>
                            </div>
                            <p>Bordeaux - Full-bodied with notes of blackcurrant</p>
                        </div>
                        <div class="menu-item">
                            <div class="item-header">
                                <h3>Cristal Champagne</h3>
                                <span class="price">$220/bottle</span>
                            </div>
                            <p>Elegant and crisp, perfect for celebrations</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Fine Dining Restaurant. All rights reserved.</p>
            <p><i class="fas fa-map-pin"></i> 123 Culinary Street | <i class="fas fa-phone"></i> (555) 123-4567 | <i class="fas fa-envelope"></i> info@finedining.com</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>

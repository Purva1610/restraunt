<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fine Dining - Restaurant</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo"><i class="fas fa-utensils"></i> Fine Dining</div>
            <ul class="nav-menu">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="/menu">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to Fine Dining</h1>
            <p>Experience Culinary Excellence</p>
            <a href="/contact" class="cta-button">Reserve a Table</a>
        </div>
    </section>

    <!-- Featured Dishes -->
    <section class="featured">
        <div class="container">
            <h2>Our Specialties</h2>
            <div class="dish-grid">
                <div class="dish-card">
                    <div class="dish-image"><i class="fas fa-bowl-food"></i></div>
                    <h3>Signature Pasta</h3>
                    <p>Handmade pasta with premium sauces and fresh ingredients</p>
                    <span class="price">$18.99</span>
                </div>
                <div class="dish-card">
                    <div class="dish-image"><i class="fas fa-drumstick-bite"></i></div>
                    <h3>Prime Steak</h3>
                    <p>Aged prime beef grilled to perfection with seasonal vegetables</p>
                    <span class="price">$32.99</span>
                </div>
                <div class="dish-card">
                    <div class="dish-image"><i class="fas fa-shrimp"></i></div>
                    <h3>Fresh Seafood</h3>
                    <p>Daily catch prepared with Mediterranean spices</p>
                    <span class="price">$28.99</span>
                </div>
                <div class="dish-card">
                    <div class="dish-image"><i class="fas fa-cake-slice"></i></div>
                    <h3>Dessert Delights</h3>
                    <p>Handcrafted desserts that end your meal perfectly</p>
                    <span class="price">$12.99</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-us">
        <div class="container">
            <h2>Why Choose Us?</h2>
            <div class="benefits-grid">
                <div class="benefit">
                    <i class="fas fa-chef-hat"></i>
                    <h3>Expert Chefs</h3>
                    <p>Our culinary team brings decades of experience from top restaurants worldwide</p>
                </div>
                <div class="benefit">
                    <i class="fas fa-leaf"></i>
                    <h3>Fresh Ingredients</h3>
                    <p>We source the finest local and organic ingredients daily</p>
                </div>
                <div class="benefit">
                    <i class="fas fa-gem"></i>
                    <h3>Elegant Ambiance</h3>
                    <p>Sophisticated atmosphere perfect for any special occasion</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Fine Dining Restaurant. All rights reserved.</p>
            <p><i class="fas fa-map-pin"></i> 123 Culinary Street | <i class="fas fa-phone"></i> (555) 123-4567 | <i class="fas fa-envelope"></i> info@finedining.com</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>

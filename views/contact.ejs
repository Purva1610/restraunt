<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - Fine Dining Restaurant</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">🍽️ Fine Dining</div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/menu">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact" class="active">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Page Title -->
    <section class="page-title">
        <h1>Contact Us</h1>
        <p>Get in touch with us</p>
    </section>

    <!-- Contact Section -->
    <section class="contact-section">
        <div class="container">
            <div class="contact-wrapper">
                <!-- Contact Info -->
                <div class="contact-info">
                    <h2>Contact Information</h2>
                    <div class="info-item">
                        <h3>📍 Address</h3>
                        <p>123 Culinary Street<br>Gourmet City, GC 12345</p>
                    </div>
                    <div class="info-item">
                        <h3>📞 Phone</h3>
                        <p>(555) 123-4567</p>
                    </div>
                    <div class="info-item">
                        <h3>📧 Email</h3>
                        <p>info@finedining.com</p>
                    </div>
                    <div class="info-item">
                        <h3>🕐 Hours</h3>
                        <p>
                            Monday - Thursday: 5:00 PM - 11:00 PM<br>
                            Friday - Saturday: 5:00 PM - 12:00 AM<br>
                            Sunday: 5:00 PM - 10:00 PM
                        </p>
                    </div>
                </div>

                <!-- Forms -->
                <div class="contact-forms">
                    <!-- Reservation Form -->
                    <div class="form-container">
                        <h2>Make a Reservation</h2>
                        <form id="reservationForm">
                            <div class="form-group">
                                <label for="res-name">Name</label>
                                <input type="text" id="res-name" name="name" required>
                            </div>
                            <div class="form-group">
                                <label for="res-email">Email</label>
                                <input type="email" id="res-email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="res-date">Date</label>
                                <input type="date" id="res-date" name="date" required>
                            </div>
                            <div class="form-group">
                                <label for="res-time">Time</label>
                                <input type="time" id="res-time" name="time" required>
                            </div>
                            <div class="form-group">
                                <label for="res-guests">Number of Guests</label>
                                <input type="number" id="res-guests" name="guests" min="1" max="20" required>
                            </div>
                            <button type="submit" class="btn-submit">Reserve Table</button>
                            <div id="res-message" class="form-message"></div>
                        </form>
                    </div>

                    <!-- Contact Form -->
                    <div class="form-container">
                        <h2>Send us a Message</h2>
                        <form id="contactForm">
                            <div class="form-group">
                                <label for="con-name">Name</label>
                                <input type="text" id="con-name" name="name" required>
                            </div>
                            <div class="form-group">
                                <label for="con-email">Email</label>
                                <input type="email" id="con-email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="con-message">Message</label>
                                <textarea id="con-message" name="message" rows="5" required></textarea>
                            </div>
                            <button type="submit" class="btn-submit">Send Message</button>
                            <div id="con-message-div" class="form-message"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Fine Dining Restaurant. All rights reserved.</p>
            <p>📍 123 Culinary Street | 📞 (555) 123-4567 | 📧 info@finedining.com</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - Ashoka's Kitchen</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">🌿 Ashoka's Kitchen</div>
      <ul class="nav-menu">
        <li><a href="/">Home</a></li>
        <li><a href="/menu">Menu</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact" class="active">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contact Section -->
  <section class="contact-section">
    <h1>Get in Touch</h1>
    
    <div class="contact-container">
      <div class="contact-info">
        <div class="info-box">
          <h3>📍 Location</h3>
          <p>Ashoka's Vegetarian Kitchen</p>
          <p>Mall Road, Nainital</p>
          <p>Nainital - 263001</p>
          <p>Uttarakhand, India</p>
        </div>

        <div class="info-box">
          <h3>📞 Phone Numbers</h3>
          <p><strong>Landline:</strong> +91 59425-12345</p>
          <p><strong>Mobile:</strong> +91 94567-89012</p>
          <p><strong>Toll Free:</strong> 1800-ASHOKA1</p>
        </div>

        <div class="info-box">
          <h3>⏰ Opening Hours</h3>
          <p><strong>Monday - Sunday:</strong></p>
          <p>Breakfast: 9:00 AM - 11:00 AM</p>
          <p>Lunch: 12:00 PM - 3:00 PM</p>
          <p>Dinner: 6:00 PM - 11:00 PM</p>
          <p style="margin-top: 10px; color: #27ae60;"><strong>Open All Days</strong></p>
        </div>

        <div class="info-box">
          <h3>✉️ Email</h3>
          <p>info@ashokasvegkitchen.com</p>
          <p>reservations@ashokasvegkitchen.com</p>
        </div>

        <div class="info-box">
          <h3>🎯 Follow Us</h3>
          <div class="social-links">
            <a href="#" class="social-btn">Facebook</a>
            <a href="#" class="social-btn">Instagram</a>
            <a href="#" class="social-btn">Twitter</a>
          </div>
        </div>
      </div>

      <div class="contact-form-container">
        <h2>Send us a Message</h2>
        <form id="contactForm" class="contact-form">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Your Name" required>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required>
          </div>

          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="+91 XXXXX XXXXX" required>
          </div>

          <div class="form-group">
            <label for="subject">Subject</label>
            <select id="subject" name="subject" required>
              <option value="">Select Subject</option>
              <option value="reservation">Reservation Inquiry</option>
              <option value="feedback">Feedback</option>
              <option value="event">Special Event</option>
              <option value="catering">Catering Services</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Your message here..." rows="5" required></textarea>
          </div>

          <button type="submit" class="submit-btn">Send Message</button>
        </form>
      </div>
    </div>

    <div class="map-container">
      <h2>Find Us on Map</h2>
      <p style="text-align: center; color: #555; margin-top: 10px;">
        Located in the heart of Nainital on the famous Mall Road, overlooking the beautiful Naini Lake
      </p>
      <div style="background: linear-gradient(135deg, #6c8e7d 0%, #f5ede4 100%); 
                  height: 300px; 
                  border-radius: 10px; 
                  margin-top: 20px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #555;
                  font-size: 18px;">
        📍 Nainital - 263001, Uttarakhand, India
      </div>
    </div>

    <!-- Image Section -->
    <div class="contact-image-section">
      <img src="/images/pexels-emrah-i-slamoglu-709221027-28460693.jpg" alt="Restaurant Interior">
      <div class="image-text">
        <h3>Visit Our Beautiful Restaurant</h3>
        <p>Experience authentic vegetarian Indian cuisine in our cozy, welcoming atmosphere in the heart of Nainital.</p>
      </div>
    </div>

    <div class="back-button">
      <a href="/" class="btn">← Back to Home</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section">
        <h4>🌿 Ashoka's Kitchen</h4>
        <p>100% Vegetarian Indian Restaurant</p>
      </div>
      <div class="footer-section">
        <h4>📍 Location</h4>
        <p>Mall Road, Nainital - 263001</p>
        <p>Uttarakhand, India</p>
      </div>
      <div class="footer-section">
        <h4>📞 Contact</h4>
        <p>Phone: +91 59425 12345</p>
        <p>Mobile: +91 94567 89012</p>
      </div>
      <div class="footer-section">
        <h4>⏰ Hours</h4>
        <p>Mon-Sun: 10:00 AM - 11:00 PM</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 Ashoka's Vegetarian Kitchen. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Fine Dining Restaurant</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo"><i class="fas fa-utensils"></i> Fine Dining</div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/menu">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Error Section -->
    <section class="error-section">
        <div class="container">
            <h1><i class="fas fa-exclamation-triangle"></i> Error</h1>
            <p><%= error %></p>
            <a href="/" class="cta-button">Return to Home</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Fine Dining Restaurant. All rights reserved.</p>
            <p><i class="fas fa-map-pin"></i> Mall Road, Near Lake View Point, Nainital, Uttarakhand - 263001 | <i class="fas fa-phone"></i> +91 98765 43210 | <i class="fas fa-envelope"></i> info@finediningnainital.com</p>

        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>

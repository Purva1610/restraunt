  <!-- About Section -->
  <section class="about-section">
    <div class="about-container">
      <h1>About Ashoka's Vegetarian Kitchen</h1>
      
      <div class="about-content">
        <div class="about-text">
          <h2>Our Story</h2>
          <p>
            Welcome to Ashoka's Vegetarian Kitchen, a culinary haven dedicated to authentic vegetarian Indian cuisine 
            nestled in the beautiful hill station of Nainital. Since our establishment, we have been serving delicious, 
            healthy, and traditional vegetarian meals to locals and tourists alike.
          </p>
          <p>
            Named after Emperor Ashoka, who was a great patron of vegetarianism, our restaurant embodies the principles 
            of vegetarian cooking with a modern twist. We believe that vegetarian food is not just a dietary choice but 
            a celebration of flavors, cultures, and wholesome ingredients.
          </p>
        </div>
        <img src="/images/pexels-emrah-i-slamoglu-709221027-28460693.jpg" alt="About Us" class="about-image">
      </div>

      <div class="mission-vision">
        <div class="mission">
          <h3>🎯 Our Mission</h3>
          <p>
            To provide the finest vegetarian Indian cuisine using locally sourced, organic ingredients while maintaining 
            traditional cooking methods and offering exceptional customer service in a warm and welcoming environment.
          </p>
        </div>
        <div class="vision">
          <h3>🌟 Our Vision</h3>
          <p>
            To become the most trusted and beloved vegetarian restaurant in Nainital, known for authentic taste, 
            quality ingredients, and hospitality that makes every guest feel like family.
          </p>
        </div>
      </div>

      <div class="team-section">
        <h2>Our Team</h2>
        <div class="team-content">
          <img src="/images/pexels-vishv-shah-2160477459-36925840.jpg" alt="Chef" class="team-image">
          <div class="team-text">
            <h3>Chef Raj Kumar</h3>
            <p><strong>Head Chef</strong></p>
            <p>
              With over 20 years of experience in Indian cuisine, Chef Raj Kumar brings authentic flavors and innovative 
              cooking techniques to every dish. His passion for vegetarian cooking and commitment to quality has made 
              Ashoka's Kitchen a culinary destination.
            </p>
          </div>
        </div>
      </div>

      <div class="values-section">
        <h2>Our Values</h2>
        <div class="values-grid">
          <div class="value">
            <h3>🥬 Quality</h3>
            <p>We use only the freshest, organic vegetables sourced locally from Nainital's surrounding farms.</p>
          </div>
          <div class="value">
            <h3>👨‍🍳 Authenticity</h3>
            <p>Traditional recipes passed down through generations, prepared with time-honored techniques.</p>
          </div>
          <div class="value">
            <h3>❤️ Care</h3>
            <p>Every dish is prepared with love and care, treating each customer as part of our family.</p>
          </div>
          <div class="value">
            <h3>🌍 Sustainability</h3>
            <p>We believe in sustainable practices and supporting local farmers and communities.</p>
          </div>
        </div>
      </div>

      <!-- Additional Gallery -->
      <div class="about-gallery">
        <h2>📸 Our Journey</h2>
        <div class="about-gallery-grid">
          <img src="/images/pexels-tamanna-rumee-52377920-8755336.jpg" alt="Kitchen">
          <img src="/images/pexels-vishv-shah-2160477459-36925840.jpg" alt="Cooking">
          <img src="/images/pexels-aperture-photography-2919538-28445587.jpg" alt="Dish">
        </div>
      </div>

      <div class="back-button">
        <a href="/" class="btn">← Back to Home</a>
      </div>

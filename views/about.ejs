        <h1>About Us</h1>
        <p>Culinary Excellence Since 2010</p>
    </section>

    <!-- About Content -->
    <section class="about-section">
        <div class="container">
            <div class="about-content">
                <h2>Our Story</h2>
                <p>Fine Dining was founded on the principle that exceptional food, paired with impeccable service, creates unforgettable memories. For over a decade, we've been dedicated to bringing the finest culinary experiences to our guests.</p>
                <p>Our head chef trained in the most prestigious restaurants across Europe and brings authentic techniques combined with innovative flavors to every plate.</p>

                <h2>Our Mission</h2>
                <p>To provide an unparalleled fine dining experience by combining fresh, locally-sourced ingredients with world-class culinary expertise and exceptional hospitality.</p>

                <h2>Our Values</h2>
                <div class="values-grid">
                    <div class="value-item">
                        <i class="fas fa-star"></i>
                        <h3>Excellence</h3>
                        <p>We strive for perfection in every aspect of your dining experience</p>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-leaf"></i>
                        <h3>Sustainability</h3>
                        <p>We source responsibly and minimize our environmental impact</p>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-heart"></i>
                        <h3>Passion</h3>
                        <p>Our team's love for food and hospitality shines through</p>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-handshake"></i>
                        <h3>Community</h3>
                        <p>We support local farmers and artisans in our community</p>
                    </div>
                </div>

                <h2>Meet Our Team</h2>
                <div class="team-grid">
                    <div class="team-member">
                        <div class="member-avatar"><i class="fas fa-chef-hat"></i></div>
                        <h3>Chef Marcus</h3>
                        <p>Head Chef</p>
                        <p class="bio">30 years of culinary experience from Michelin-starred restaurants</p>
                    </div>
                    <div class="team-member">
                        <div class="member-avatar"><i class="fas fa-user-chef"></i></div>
                        <h3>Chef Elena</h3>
                        <p>Sous Chef</p>
                        <p class="bio">Specializes in contemporary European cuisine</p>
                    </div>
                    <div class="team-member">
                        <div class="member-avatar"><i class="fas fa-user-tie"></i></div>
                        <h3>James</h3>
                        <p>Restaurant Manager</p>
                        <p class="bio">Ensures every guest receives exceptional service</p>
                    </div>
                </div>
            </div>
        </div>
    </section>


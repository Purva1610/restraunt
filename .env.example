# Application Environment Configuration
NODE_ENV=production

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Application Settings
APP_NAME=Haris Vegetarian Kitchen
APP_DESCRIPTION=Authentic Vegetarian Indian Cuisine in Nainital

# Database (if needed in future)
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=haris_restaurant

# Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@harisvegkitchen.com

# Logging
LOG_LEVEL=info

# CORS Settings
CORS_ORIGIN=*

# Session Configuration
# SESSION_SECRET=your-secret-key-here
